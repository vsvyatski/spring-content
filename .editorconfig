# https://editorconfig.org
# Match Checkstyle NewlineAtEndOfFile on boot starters: every text file ends with one newline.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf
