# https://editorconfig.org — workspace baseline (matches boot-create-pdf / demo-player, Java = spaces per existing sources)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{xml,yml,yaml,adoc,asciidoc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.properties]
trim_trailing_whitespace = false
indent_size = 2

# Unix shell scripts (including Maven wrapper)
[{mvnw,*.sh}]
end_of_line = lf

[*.cmd]
end_of_line = crlf
